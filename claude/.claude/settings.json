{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:*)",
      "Read(**)",
      "Grep(**)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh status *)",
      "Bash(gh api *)",
      "Bash(git *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(ls *)",
      "Bash(cd *)",
      "Bash(find *)",
      "Bash(curl *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(sops *)",
      "Bash(kubectl *)",
      "Bash(bash *)",
      "Bash(nvim --version)",
      "Bash(node --version)",
      "Bash(npm list *)",
      "mcp__claude_ai_Atlassian_MCP__createJiraIssue",
      "mcp__claude_ai_Atlassian_MCP__createIssueLink",
      "mcp__claude_ai_Atlassian_MCP__editJiraIssue",
      "mcp__claude_ai_Atlassian_MCP__transitionJiraIssue",
      "Skill(artifact-design)",
      "Skill(artifact-design:*)"
    ],
    "deny": [
      "mcp__atlassian__jira_delete_issue",
      "mcp__atlassian__jira_remove_issue_link",
      "mcp__atlassian__jira_remove_watcher",
      "mcp__atlassian__jira_update_sprint",
      "mcp__atlassian__jira_update_proforma_form_answers",
      "mcp__atlassian__jira_batch_create_issues",
      "mcp__atlassian__jira_create_remote_issue_link",
      "mcp__atlassian__jira_create_sprint",
      "mcp__atlassian__jira_create_version",
      "mcp__atlassian__jira_batch_create_versions",
      "mcp__atlassian__jira_add_issues_to_sprint",
      "mcp__atlassian__jira_link_to_epic"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/ianliu/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "outputStyle": "Tech Style",
  "viewMode": "focus",
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org"
      ]
    }
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:tokyonight-night",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "git push --force-with-lease (never plain --force) of a feature branch, not main or master, after the user confirmed that push in the conversation"
    ],
    "environment": [
      "$defaults"
    ]
  },
  "voiceEnabled": true
}
